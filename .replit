modules = ["php-8.2", "nodejs-20", "web"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "php -S 0.0.0.0:5000 -t public"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "vm"
run = ["php", "-S", "0.0.0.0:5000", "-t", "public"]
build = ["composer", "install", "--no-dev", "--optimize-autoloader", "--no-scripts"]

[userenv]

[userenv.shared]
CI_ENVIRONMENT = "production"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000
